# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# HashiCorp Vault
VAULT_TOKEN=             # Token root récupéré via: sudo cat /etc/vault.d/init.json
VAULT_ADDR=              # ex: http://127.0.0.1:8200 (avec tunnel SSH actif)

# Gateway SSH (pfSense)
GATEWAY_USER=            # ex: sysadmin
GATEWAY_HOST=            # IP publique du pfSense
GATEWAY_PORT=            # ex: 2222
SSH_KEY=                 # ex: ~/.ssh/ansible_key
