# Copier ce fichier en .env et remplir les valeurs
# cp .env.example .env

# HashiCorp Vault
VAULT_TOKEN=             # Token root récupéré via: sudo cat /etc/vault.d/init.json
VAULT_ADDR=              # ex: https://127.0.0.1:8200 (avec tunnel SSH actif)
VAULT_SKIP_VERIFY=true  # certificat auto-signé, désactive la vérification TLS

# Gateway SSH (pfSense)
GATEWAY_USER=            # ex: sysadmin
GATEWAY_HOST=            # IP publique du pfSense
GATEWAY_PORT=            # ex: 2222
SSH_KEY=                 # ex: ~/.ssh/ansible_key

# IPs internes des VMs (utilisées pour les tunnels SSH)
VAULT_INTERNAL_HOST=     # ex: 192.168.30.101
NETBOX_INTERNAL_HOST=    # ex: 192.168.10.101

# Mots de passe sudo pour les VMs (utilisés dans les playbooks Ansible)
WEBSERVER_VM_SUDO_PASS=  
BASTION_VM_SUDO_PASS=    
LAN_VM_SUDO_PASS=        
VAULT_VM_SUDO_PASS=      

# Site 2 — variables SSH (peuvent être surchargées si différentes des défauts Makefile)
# S2_GATEWAY_HOST=5.39.122.40   # IP WAN pfSense Site 2 (défaut Makefile)
# S2_GATEWAY_USER=t-nsa-810-cia # Utilisateur VMs Site 2 (défaut Makefile)
# BASTION_PORT=2231              # NAT SSH → bastion_vm (défaut Makefile)
# WEBSERVER_PORT=2232            # NAT SSH → webserver_vm (défaut Makefile)
