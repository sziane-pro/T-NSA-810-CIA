# Managed by Ansible — do not edit manually
[DEFAULT]
bantime  = 3600
findtime = 600
maxretry = 3
backend  = systemd
ignoreip = 127.0.0.1/8 {{ vpn_tunnel_network }}

[sshd]
enabled  = true
port     = {{ ssh_port | default(22) }}
filter   = sshd
logpath  = /var/log/auth.log
maxretry = 3
banaction = iptables-multiport
