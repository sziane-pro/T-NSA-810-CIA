[SERVICE]
    Flush         5
    Log_Level     warning
    Daemon        Off
    Parsers_File  parsers.conf

[INPUT]
    Name          tail
    Path          /var/log/auth.log,/var/log/syslog
    Tag           system
    Read_From_Head False

# Logs d'acces Nginx (site web interne) — present uniquement sur webserver_vm,
# ignore sans erreur ailleurs. Deja en JSON (cf. nginx.conf).
[INPUT]
    Name          tail
    Path          /var/log/nginx/access.log
    Tag           nginx
    Parser        nginx_json
    Read_From_Head False

[FILTER]
    Name          parser
    Match         system
    Key_Name      log
    Parser        extract_syslog_json
    Reserve_Data  On

# Structure les lignes syslog "classiques" (sans payload JSON) :
# process + message requetables (SSH, sudo, fail2ban...).
[FILTER]
    Name          parser
    Match         system
    Key_Name      log
    Parser        syslog_plain
    Reserve_Data  On

[FILTER]
    Name          record_modifier
    Match         *
    Record        source_host {{ inventory_hostname }}

[OUTPUT]
    Name          opensearch
    Match         *
    Host          {{ opensearch_host }}
    Port          9200
    HTTP_User     admin
    HTTP_Passwd   {{ opensearch_admin_password }}
    TLS           Off
    TLS.Verify    Off
    Index         fluent-bit
    Suppress_Type_Name On